// use prisma-8

// ==========================================
// 1. MASTER DATA (SINGLE SOURCE OF TRUTH)
// ==========================================

model MasterKecamatan {
  id              String   @id @onCreate(uuid())
  namaKecamatan   String   @unique
  kodeKecamatan   String?  @unique
  createdAt       DateTime @onCreate(now())
  updatedAt       DateTime @onCreate(now()) @onUpdate(now())

  // Relasi
  kua             KuaProfile[]
  masjid          DataMasjid[]
  lembaga         DataLembagaKeagamaan[]
  penghulu        Pegawai[]
}

model MasterJabatan {
  id          String   @id @onCreate(uuid())
  namaJabatan String   @unique
  deskripsi   String?
  createdAt   DateTime @onCreate(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  // Relasi
  pegawai     Pegawai[]
}

// ==========================================
// 2. PEGAWAI & MANAJEMEN INTERNAL KUA
// ==========================================

model Pegawai {
  id               String          @id @onCreate(uuid())
  nip              String          @unique
  namaLengkap      String
  gelarDepan       String?
  gelarBelakang    String?
  jabatanId        String
  jabatan          MasterJabatan   @relation(fields: [jabatanId], references: [id])
  kecamatanId      String?
  kecamatan        MasterKecamatan? @relation(fields: [kecamatanId], references: [id])
  nomorHp          String?
  email            String?         @unique
  fotoUrl          String?
  statusKeaktifan  Boolean         @default(true)
  createdAt        DateTime        @onCreate(now())
  updatedAt        DateTime        @onCreate(now()) @onUpdate(now())

  // Relasi Layanan
  layananPtsp      LayananPtsp[]   @relation("PetugasPtsp")
  pernikahan       PencatatanNikah[] @relation("PencatatNikah")
}

model KuaProfile {
  id              String          @id @onCreate(uuid())
  namaKua         String
  kecamatanId     String          @unique
  kecamatan       MasterKecamatan @relation(fields: [kecamatanId], references: [id])
  alamat          String
  telepon         String?
  email           String?
  kepalaKuaNip    String?
  createdAt       DateTime        @onCreate(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())
}

// ==========================================
// 3. LAYANAN PTSP (PUBLIC SERVICES)
// ==========================================

model LayananPtsp {
  id              String          @id @onCreate(uuid())
  nomorTiket      String          @unique
  namaPemohon     String
  nikPemohon      String
  jenisLayanan    String          
  keperluan       String
  status          String          @default("PENDING") 
  petugasId       String?
  petugas         Pegawai?        @relation("PetugasPtsp", fields: [petugasId], references: [id])
  catatanPetugas  String?
  berkasUrl       String?
  createdAt       DateTime        @onCreate(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())
}

// ==========================================
// 4. PENCATATAN NIKAH (SIMK)
// ==========================================

model PencatatanNikah {
  id              String          @id @onCreate(uuid())
  nomorPendaftaran String         @unique
  namaSuami       String
  namaIstri       String
  tanggalAkad     DateTime
  lokasiAkad      String          
  alamatAkad      String
  penghuluId      String
  penghulu        Pegawai         @relation("PencatatNikah", fields: [penghuluId], references: [id])
  statusNikah     String          @default("TERDAFTAR") 
  createdAt       DateTime        @onCreate(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())
}

// ==========================================
// 5. DATA KEBIMASISLAMAN (MASJID & LEMBAGA)
// ==========================================

model DataMasjid {
  id              String          @id @onCreate(uuid())
  namaMasjid      String
  tipeMasjid      String          
  kecamatanId     String
  kecamatan       MasterKecamatan @relation(fields: [kecamatanId], references: [id])
  alamatLengkap   String
  tahunBerdiri    Int?
  luasTanah       Float?
  statusTanah     String?         
  namaTakmir      String?
  kontakTakmir    String?
  createdAt       DateTime        @onCreate(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())
}

model DataLembagaKeagamaan {
  id              String          @id @onCreate(uuid())
  namaLembaga     String
  jenisLembaga    String          
  kecamatanId     String
  kecamatan       MasterKecamatan @relation(fields: [kecamatanId], references: [id])
  alamat          String
  pimpinan        String
  nomorSk         String?
  tahunBerdiri    Int?
  createdAt       DateTime        @onCreate(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())
}